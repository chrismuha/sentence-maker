{
  "name": "sentence-maker",
  "productName": "Sentence Maker",
  "version": "1.0.0",
  "description": "Desktop sentence breaker built with Electron.",
  "main": "main.js",
  "scripts": {
    "start": "npm run dev",
    "start:prod": "env -u ELECTRON_RUN_AS_NODE NODE_ENV=production electron .",
    "dev": "npm run dev:main",
    "dev:renderer": "echo \"No renderer dev server configured for sentence-maker\"",
    "dev:main": "env -u ELECTRON_RUN_AS_NODE NODE_ENV=development electron .",
    "build": "npm run dist",
    "build:web": "echo \"No web build configured for sentence-maker\"",
    "dist": "npm run dist:mac:universal",
    "dist:mac:x64": "npm run generate-icons && npm run build:web && electron-builder --mac --x64",
    "dist:mac:arm64": "npm run generate-icons && npm run build:web && electron-builder --mac --arm64",
    "dist:mac:universal": "npm run generate-icons && npm run build:web && electron-builder --mac --universal",
    "build:mac:x64": "npm run dist:mac:x64",
    "build:mac:arm64": "npm run dist:mac:arm64",
    "build:mac:universal": "npm run dist:mac:universal",
    "dist:win": "npm run generate-icons && npm run build:web && electron-builder --win",
    "dist:linux": "npm run build:web && electron-builder --linux",
    "build:win": "npm run dist:win",
    "build:linux": "npm run dist:linux",
    "package": "echo \"electron-forge package is not configured for sentence-maker\"",
    "make": "echo \"electron-forge make is not configured for sentence-maker\"",
    "publish": "echo \"electron-forge publish is not configured for sentence-maker\"",
    "lint": "echo \"No linting configured\"",
    "generate-icons": "echo \"No icon generation configured\"",
    "all": "echo \"Shared all-script is not configured for sentence-maker\"",
    "scripts": "echo \"Shared scripts runner is not configured for sentence-maker\""
  },
  "keywords": [],
  "author": {
    "name": "Chris Muha"
  },
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^39.2.5",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "boolean": "^3.2.0",
    "buffer-crc32": "^0.2.13",
    "cacheable-lookup": "^5.0.4",
    "cacheable-request": "^7.0.4",
    "clone-response": "^1.0.3",
    "debug": "^4.4.3",
    "decompress-response": "^6.0.0",
    "defer-to-connect": "^2.0.1",
    "define-data-property": "^1.1.4",
    "define-properties": "^1.2.1",
    "detect-node": "^2.1.0",
    "end-of-stream": "^1.4.5",
    "env-paths": "^2.2.1",
    "es-define-property": "^1.0.1",
    "es-errors": "^1.3.0",
    "es6-error": "^4.1.1",
    "escape-string-regexp": "^4.0.0",
    "extract-zip": "^2.0.1",
    "fd-slicer": "^1.1.0",
    "fs-extra": "^8.1.0",
    "get-stream": "^5.2.0",
    "global-agent": "^3.0.0",
    "globalthis": "^1.0.4",
    "gopd": "^1.2.0",
    "got": "^11.8.6",
    "graceful-fs": "^4.2.11",
    "has-property-descriptors": "^1.0.2",
    "http-cache-semantics": "^4.2.0",
    "http2-wrapper": "^1.0.3",
    "json-buffer": "^3.0.1",
    "json-stringify-safe": "^5.0.1",
    "jsonfile": "^4.0.0",
    "keyv": "^4.5.4",
    "lowercase-keys": "^2.0.0",
    "matcher": "^3.0.0",
    "mimic-response": "^1.0.1",
    "ms": "^2.1.3",
    "normalize-url": "^9.0.0",
    "object-keys": "^1.1.1",
    "once": "^1.4.0",
    "p-cancelable": "^2.1.1",
    "pend": "^1.2.0",
    "progress": "^2.0.3",
    "pump": "^3.0.3",
    "quick-lru": "^5.1.1",
    "resolve-alpn": "^1.2.1",
    "responselike": "^2.0.1",
    "roarr": "^2.15.4",
    "semver": "^6.3.1",
    "semver-compare": "^1.0.0",
    "serialize-error": "^7.0.1",
    "sprintf-js": "^1.1.3",
    "sumchecker": "^3.0.1",
    "type-fest": "^0.13.1",
    "undici-types": "^6.21.0",
    "universalify": "^0.1.2",
    "wrappy": "^1.0.2",
    "yauzl": "^2.10.0"
  }
}
